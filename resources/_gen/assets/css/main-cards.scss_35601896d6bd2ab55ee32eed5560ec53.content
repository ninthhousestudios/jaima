body[a="dark"]{background-color:#000;color:#eee}body[a="dark"] a{color:lime}body[a="dark"] a:visited{color:#6b00ff}body[a="dark"] details{border:thin solid #eee}body[a="dark"] details summary{color:#eee}body[a="dark"] details[open] summary{border-bottom:1px solid #eee}body[a="dark"] pre{background:#000}body[a="dark"] code:not(pre>code){background-color:#eee;color:#000}body[a="dark"] *:target{background:#16213e;color:#eee}body[a="dark"] table,body[a="dark"] th,body[a="dark"] td{border:thin solid #eee}body[a="dark"] .toc{border:thin solid #eee;padding:1rem}body[a="dark"] figcaption{color:#666}body[a="dark"] blockquote{border:thin solid #eee}body[a="light"]{background-color:#fff;color:#333}body[a="light"] a{color:#1976d2}body[a="light"] a:visited{color:#7b1fa2}body[a="light"] details{border:thin solid #333}body[a="light"] details summary{color:#333}body[a="light"] details[open] summary{border-bottom:1px solid #333}body[a="light"] pre{background:#fff}body[a="light"] code:not(pre>code){background-color:#333;color:#fff}body[a="light"] *:target{background:#e3f2fd;color:#333}body[a="light"] table,body[a="light"] th,body[a="light"] td{border:thin solid #333}body[a="light"] .toc{border:thin solid #333;padding:1rem}body[a="light"] figcaption{color:#888}body[a="light"] blockquote{border:thin solid #333}@media (prefers-color-scheme: dark){body[a="auto"]{background-color:#000;color:#eee}body[a="auto"] a{color:lime}body[a="auto"] a:visited{color:#6b00ff}body[a="auto"] details{border:thin solid #eee}body[a="auto"] details summary{color:#eee}body[a="auto"] details[open] summary{border-bottom:1px solid #eee}body[a="auto"] pre{background:#000}body[a="auto"] code:not(pre>code){background-color:#eee;color:#000}body[a="auto"] *:target{background:#16213e;color:#eee}body[a="auto"] table,body[a="auto"] th,body[a="auto"] td{border:thin solid #eee}body[a="auto"] .toc{border:thin solid #eee;padding:1rem}body[a="auto"] figcaption{color:#666}body[a="auto"] blockquote{border:thin solid #eee}}@media (prefers-color-scheme: light){body[a="auto"]{background-color:#fff;color:#333}body[a="auto"] a{color:#1976d2}body[a="auto"] a:visited{color:#7b1fa2}body[a="auto"] details{border:thin solid #333}body[a="auto"] details summary{color:#333}body[a="auto"] details[open] summary{border-bottom:1px solid #333}body[a="auto"] pre{background:#fff}body[a="auto"] code:not(pre>code){background-color:#333;color:#fff}body[a="auto"] *:target{background:#e3f2fd;color:#333}body[a="auto"] table,body[a="auto"] th,body[a="auto"] td{border:thin solid #333}body[a="auto"] .toc{border:thin solid #333;padding:1rem}body[a="auto"] figcaption{color:#888}body[a="auto"] blockquote{border:thin solid #333}}html{height:100%}body{font-family:Georgia, serif;font-size:18px;line-height:1.7;margin:0;min-height:100%;overflow-wrap:break-word}h2,h3,h4,h5,h6{margin-top:2rem;font-weight:400}p{margin:1.2rem 0}li{margin:0.5rem 0}a{text-decoration:none;border-bottom:1px solid currentColor}a:hover{text-decoration:none;border-bottom-style:dashed}hr{text-align:center;border:0;margin:2.5rem 0}hr:before{content:'✦ ✦ ✦'}hr:after{content:attr(data-content) " ✦ ✦ ✦"}pre{padding:1em;overflow-x:auto;font-family:"SF Mono", Monaco, monospace;font-size:0.85rem}table{width:100%}table,th,td{border-collapse:collapse;padding:0.5rem}code{font-family:"SF Mono", Monaco, monospace;font-size:0.9em}code:not(pre>code){padding:0.1em 0.3em;border-radius:3px;font-size:0.85em}code.has-jax{-webkit-font-smoothing:antialiased;background:inherit !important;border:none !important;font-size:100%}blockquote{padding:1rem 1.5rem;font-style:italic;border-left:3px solid currentColor}blockquote p{margin:0}img{max-width:100%;display:block;margin:0 auto}figcaption{text-align:center;opacity:0.6;font-size:0.9rem;font-style:italic}details{padding:1rem}details summary{text-decoration:none}details[open] summary{margin-bottom:0.5em;padding-bottom:0.5em}.post-meta{display:flex;justify-content:space-between;align-items:center}.w{max-width:700px;margin:0 auto;padding:4rem 2rem}.toc{padding:1rem}header.site-header{background:rgba(0,0,0,0.03);padding:2rem;margin:-4rem -2rem 3rem -2rem;border-bottom:2px solid currentColor;text-align:center}header.site-header h1{font-size:2.2rem;margin-bottom:0.5rem;font-weight:400;letter-spacing:-0.01em}header.site-header p{font-size:1rem;opacity:0.7;margin:0}body[a="dark"] header.site-header{background:rgba(255,255,255,0.08);border-bottom-color:#333}.menu-cards{display:grid;grid-template-columns:repeat(auto-fit, minmax(120px, 1fr));gap:1rem;margin:2rem 0}.menu-cards ul{list-style:none;padding:0;margin:0;display:contents}.menu-cards li{margin:0}.menu-cards a{display:block;padding:1rem;border:1px solid currentColor;text-align:center;font-size:0.9rem;transition:all 0.2s ease}.menu-cards a:hover{text-decoration:none;transform:translateY(-2px);box-shadow:0 4px 8px rgba(0,0,0,0.1)}.menu-cards a:visited{opacity:0.8}.menu-section-inline{text-align:center;margin:1.5rem 0 2.5rem;font-size:0.9rem}.menu-section-inline a{margin:0 1rem;padding:0.2rem 0;border-bottom:2px solid transparent}.menu-section-inline a:hover{border-bottom-color:currentColor;text-decoration:none}

