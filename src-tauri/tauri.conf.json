{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jaima",
  "version": "0.1.0",
  "identifier": "com.ninthhousestudios.jaima",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "ജയ്മാ",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "url": "http://localhost:43823"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
