---
import Base from '../layouts/Base.astro';
---
<Base>
  <div id="threshold">
    <div class="mantra-lines">
      <p class="mantra ml" lang="ml">ഓം അമൃതേശ്വര്യൈ നമഃ</p>
      <p class="mantra iast">oṃ amṛteśvaryai namaḥ</p>
      <p class="mantra dev" lang="hi">ॐ अमृतेश्वर्यै नमः</p>
    </div>
  </div>
  <div id="room">
    <div id="atmosphere"></div>
    <div id="darshan">
      <img src="/images/photos/amma-devi1.png" alt="Amma in Devi Bhava" id="darshan-photo" />
    </div>
    <canvas id="particles"></canvas>
    <div id="lotus-container"></div>
  </div>
</Base>

<script>
  import { initParticles } from '../components/particles';
  import { initLotusNav } from '../components/lotus-nav';
  import { initTabMantra } from '../components/tab-mantra';
  import { initPhotoMode } from '../components/photo-mode';
  import { initJapaMode, destroyJapa } from '../components/japa-mode';
  import { initGarlandMode } from '../components/garland-mode';
  import { initTeachingsMode } from '../components/teachings-mode';
  import { initSoundMode } from '../components/sound-mode';
  import type { Mode } from '../components/lotus-nav';

  let modesInitialized = false;

  function initModes() {
    if (modesInitialized) return;
    modesInitialized = true;
    const room = document.getElementById('room')!;
    const darshan = document.getElementById('darshan')!;
    initPhotoMode(darshan);
    initJapaMode(room);
    initGarlandMode(room);
    initTeachingsMode(room);
    initSoundMode(room);
  }

  function handleModeChange(mode: Mode | null) {
    document.querySelectorAll('.mode-overlay').forEach(el => {
      (el as HTMLElement).classList.remove('active');
    });
    if (!mode) {
      destroyJapa();
      return;
    }
    const overlay = document.getElementById(`mode-${mode}`);
    if (overlay) overlay.classList.add('active');
    if (mode !== 'japa') destroyJapa();
  }

  function initAtmosphere() {
    const root = document.documentElement;
    const hour = new Date().getHours();

    let hue: number, saturation: number, lightness: number, warmth: number;

    if (hour >= 5 && hour < 8) {
      // Dawn — soft gold, gentle
      hue = 35; saturation = 60; lightness = 12; warmth = 0.7;
    } else if (hour >= 8 && hour < 12) {
      // Morning — warmer, brighter
      hue = 30; saturation = 55; lightness = 14; warmth = 0.8;
    } else if (hour >= 12 && hour < 16) {
      // Midday — brightest, most saturated
      hue = 25; saturation = 50; lightness = 16; warmth = 0.9;
    } else if (hour >= 16 && hour < 19) {
      // Evening — deep warmth, saffron
      hue = 20; saturation = 65; lightness = 13; warmth = 0.85;
    } else if (hour >= 19 && hour < 22) {
      // Dusk — crimson deepening
      hue = 350; saturation = 50; lightness = 10; warmth = 0.6;
    } else {
      // Night — intimate, lamp-like
      hue = 340; saturation = 40; lightness = 8; warmth = 0.4;
    }

    root.style.setProperty('--atm-hue', String(hue));
    root.style.setProperty('--atm-sat', `${saturation}%`);
    root.style.setProperty('--atm-lit', `${lightness}%`);
    root.style.setProperty('--atm-warmth', String(warmth));
    root.style.setProperty('--atm-glow-color', `hsl(${hue}, ${saturation}%, ${lightness + 10}%)`);
    root.style.setProperty('--atm-glow-opacity', String(warmth * 0.3));
  }

  function runThreshold() {
    const threshold = document.getElementById('threshold')!;
    const room = document.getElementById('room')!;
    const mantras = threshold.querySelectorAll<HTMLElement>('.mantra');

    let entered = false;

    function enterRoom() {
      if (entered) return;
      entered = true;

      threshold.classList.add('dissolving');
      threshold.addEventListener('transitionend', () => {
        threshold.style.display = 'none';
      }, { once: true });

      room.classList.add('entering');

      const canvas = document.getElementById('particles') as HTMLCanvasElement;
      if (canvas) initParticles(canvas);

      const lotusContainer = document.getElementById('lotus-container')!;
      initLotusNav(lotusContainer, handleModeChange);

      initModes();
    }

    mantras.forEach((el, i) => {
      setTimeout(() => {
        el.classList.add('visible');
      }, 800 + i * 1200);
    });

    const autoEnterDelay = 800 + mantras.length * 1200 + 2500;
    const autoTimer = setTimeout(enterRoom, autoEnterDelay);

    threshold.addEventListener('click', () => {
      clearTimeout(autoTimer);
      enterRoom();
    });

    threshold.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        clearTimeout(autoTimer);
        enterRoom();
      }
    });

    threshold.setAttribute('tabindex', '0');
    threshold.focus();
  }

  initAtmosphere();
  initTabMantra();
  runThreshold();
</script>

<style>
  #threshold {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    background: #0a0008;
    cursor: pointer;
    opacity: 1;
    transition: opacity 2s ease-out;
  }

  #threshold.dissolving {
    opacity: 0;
    pointer-events: none;
  }

  .mantra-lines {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.8rem;
  }

  .mantra {
    font-size: clamp(1.2rem, 3vw, 2rem);
    opacity: 0;
    letter-spacing: 0.05em;
    color: #d4a574;
    transition: opacity 1.5s ease-in;
    text-shadow: 0 0 30px hsla(30, 60%, 50%, 0.3);
  }

  .mantra.visible {
    opacity: 1;
  }

  #room {
    position: fixed;
    inset: 0;
    opacity: 0;
    transition: opacity 2.5s ease-in 0.5s;
  }

  #room.entering {
    opacity: 1;
  }

  #atmosphere {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 60% 70% at 50% 50%,
        hsla(var(--atm-hue, 30), var(--atm-sat, 50%), calc(var(--atm-lit, 12%) + 8%), var(--atm-glow-opacity, 0.2)),
        transparent
      ),
      radial-gradient(
        ellipse 80% 90% at 50% 60%,
        hsla(var(--atm-hue, 30), var(--atm-sat, 50%), var(--atm-lit, 12%), 0.15),
        transparent
      );
    pointer-events: none;
    z-index: 1;
  }

  #darshan {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 0;
  }

  #darshan-photo {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    filter: brightness(0.85) saturate(1.1);
  }

  #particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
  }

  #lotus-container {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 50;
  }
</style>

<style is:global>
  .lotus-nav {
    position: relative;
    width: 140px;
    height: 140px;
    cursor: pointer;
  }

  .lotus-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 0 8px hsla(30, 60%, 50%, 0.3));
  }

  .lotus-center {
    fill: hsla(340, 40%, 55%, 0.9);
    stroke: hsla(35, 50%, 70%, 0.6);
    stroke-width: 1.5;
    cursor: pointer;
    transition: fill 0.4s ease, filter 0.4s ease;
  }

  .lotus-center:hover {
    fill: hsla(340, 50%, 62%, 1);
    filter: drop-shadow(0 0 6px hsla(340, 50%, 60%, 0.5));
  }

  .lotus-petal {
    fill: hsla(335, 45%, 65%, 0.85);
    stroke: hsla(35, 60%, 75%, 0.4);
    stroke-width: 0.5;
    cursor: pointer;
    transition: d 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
                fill 0.3s ease,
                filter 0.3s ease;
  }

  .lotus-petal:hover:not(.disabled) {
    fill: hsla(335, 55%, 72%, 1);
    filter: drop-shadow(0 0 4px hsla(335, 50%, 65%, 0.5));
  }

  .lotus-petal.active {
    fill: hsla(40, 60%, 70%, 0.95);
    stroke: hsla(40, 70%, 80%, 0.6);
  }

  .lotus-petal.disabled {
    fill: hsla(335, 20%, 45%, 0.4);
    stroke: hsla(35, 20%, 50%, 0.2);
    cursor: default;
  }

  .lotus-label {
    fill: #e8d5c4;
    font-size: 9px;
    font-family: system-ui, sans-serif;
    pointer-events: none;
    transition: opacity 0.4s ease 0.15s;
  }

  .lotus-label.disabled {
    fill: hsla(30, 20%, 60%, 0.5);
    font-style: italic;
  }

  .lotus-glow {
    position: absolute;
    bottom: 50%;
    right: 50%;
    transform: translate(50%, 50%);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: transparent;
    transition: background 0.6s ease, box-shadow 0.6s ease;
    pointer-events: none;
  }

  .lotus-glow.active {
    background: hsla(var(--glow-hue, 35), 50%, 50%, 0.08);
    box-shadow: 0 0 20px 8px hsla(var(--glow-hue, 35), 50%, 50%, 0.15);
  }

  /* Mode overlays — hidden by default */
  .mode-overlay {
    display: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .mode-overlay.active {
    display: flex;
    opacity: 1;
  }

  /* Photo mode */
  .photo-nav {
    position: absolute;
    inset: 0;
    z-index: 20;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
    pointer-events: none;
  }

  .photo-arrow {
    pointer-events: auto;
    background: hsla(0, 0%, 0%, 0.3);
    border: 1px solid hsla(30, 40%, 60%, 0.3);
    color: #e8d5c4;
    font-size: 2.5rem;
    padding: 0.5rem 1rem;
    cursor: pointer;
    border-radius: 50%;
    transition: background 0.3s ease;
    line-height: 1;
  }

  .photo-arrow:hover {
    background: hsla(0, 0%, 0%, 0.5);
  }

  .darshan-photo-transition {
    position: absolute;
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    filter: brightness(0.85) saturate(1.1);
    opacity: 0;
    transition: opacity 1.5s ease;
  }

  .darshan-photo-transition.visible {
    opacity: 1;
  }

  #darshan-photo {
    transition: opacity 1.5s ease;
  }

  #darshan-photo.fading {
    opacity: 0;
  }

  /* Japa mode */
  .japa-overlay {
    position: fixed;
    inset: 0;
    z-index: 30;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: hsla(0, 0%, 0%, 0.4);
    pointer-events: auto;
    cursor: pointer;
  }

  .japa-display {
    text-align: center;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .japa-name {
    font-size: clamp(1.5rem, 5vw, 3rem);
    color: #f0d8b8;
    text-shadow: 0 0 30px hsla(30, 60%, 50%, 0.4);
    opacity: 0;
    transition: opacity 0.4s ease;
    letter-spacing: 0.03em;
  }

  .japa-name.visible {
    opacity: 1;
  }

  .japa-counter {
    margin-top: 1rem;
    color: hsla(30, 30%, 60%, 0.6);
    font-size: 0.85rem;
  }

  .japa-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 1.5rem;
    cursor: default;
    background: hsla(0, 0%, 0%, 0.3);
  }

  .japa-scripts {
    display: flex;
    gap: 0.5rem;
  }

  .japa-script {
    background: hsla(30, 20%, 30%, 0.5);
    border: 1px solid hsla(30, 40%, 50%, 0.3);
    color: #d4b89a;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    border-radius: 4px;
    font-size: 0.9rem;
    transition: background 0.3s ease;
  }

  .japa-script.active {
    background: hsla(30, 40%, 40%, 0.7);
    border-color: hsla(30, 50%, 60%, 0.5);
    color: #f0d8b8;
  }

  .japa-playback {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .japa-stream-toggle,
  .japa-advance {
    background: hsla(30, 20%, 30%, 0.5);
    border: 1px solid hsla(30, 40%, 50%, 0.3);
    color: #d4b89a;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    border-radius: 4px;
    font-size: 1rem;
    transition: background 0.3s ease;
  }

  .japa-stream-toggle:hover,
  .japa-advance:hover {
    background: hsla(30, 30%, 38%, 0.6);
  }

  .japa-speed {
    width: 80px;
    accent-color: #d4a574;
  }

  /* Garland mode */
  .garland-overlay {
    position: absolute;
    inset: 0;
    z-index: 15;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .garland-display {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .garland-svg {
    animation: garland-drape 2s ease-out forwards;
  }

  @keyframes garland-drape {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .garland-controls {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    display: flex;
    gap: 0.5rem;
    pointer-events: auto;
    z-index: 20;
  }

  .garland-pick {
    background: hsla(30, 20%, 30%, 0.6);
    border: 1px solid hsla(30, 40%, 50%, 0.3);
    color: #d4b89a;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    border-radius: 4px;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: background 0.3s ease;
  }

  .garland-pick.active {
    background: hsla(30, 40%, 40%, 0.7);
    border-color: hsla(30, 50%, 60%, 0.5);
  }

  .garland-swatch {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }

  /* Teachings mode */
  .teachings-overlay {
    position: fixed;
    inset: 0;
    z-index: 30;
    align-items: center;
    justify-content: center;
    background: hsla(0, 0%, 0%, 0.45);
    cursor: pointer;
  }

  .teachings-display {
    max-width: 600px;
    padding: 3rem;
    text-align: center;
  }

  .teachings-quote {
    font-size: clamp(1.1rem, 3vw, 1.6rem);
    color: #f0d8b8;
    font-style: italic;
    line-height: 1.6;
    opacity: 0;
    transition: opacity 0.5s ease;
    text-shadow: 0 0 20px hsla(30, 50%, 50%, 0.2);
    border: none;
    margin: 0;
    padding: 0;
  }

  .teachings-quote.visible {
    opacity: 1;
  }

  .teachings-attr {
    margin-top: 1.5rem;
    color: hsla(30, 40%, 65%, 0.7);
    font-size: 0.95rem;
  }

  /* Sound mode */
  .sound-overlay {
    position: fixed;
    bottom: 6rem;
    right: 2rem;
    z-index: 40;
    flex-direction: column;
    align-items: flex-end;
  }

  .sound-display {
    background: hsla(0, 0%, 8%, 0.85);
    border: 1px solid hsla(30, 40%, 50%, 0.2);
    border-radius: 8px;
    padding: 1.2rem;
  }

  .sound-placeholder {
    color: hsla(30, 30%, 60%, 0.6);
    font-size: 0.85rem;
    margin-bottom: 0.8rem;
  }

  .sound-tracks {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .sound-track {
    background: hsla(30, 20%, 30%, 0.4);
    border: 1px solid hsla(30, 30%, 40%, 0.3);
    color: hsla(30, 20%, 50%, 0.5);
    padding: 0.4rem 1rem;
    border-radius: 4px;
    font-size: 0.85rem;
    cursor: not-allowed;
    text-align: left;
  }
</style>
