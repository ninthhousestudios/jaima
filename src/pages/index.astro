---
import Base from '../layouts/Base.astro';
---
<Base>
  <div id="threshold">
    <div class="mantra-lines">
      <p class="mantra ml" lang="ml">ഓം അമൃതേശ്വര്യൈ നമഃ</p>
      <p class="mantra iast">oṃ amṛteśvaryai namaḥ</p>
      <p class="mantra dev" lang="hi">ॐ अमृतेश्वर्यै नमः</p>
    </div>
  </div>
  <div id="room">
    <div id="atmosphere"></div>
    <div id="altar">
      <div id="darshan">
        <img src="/images/photos/amma-devi1.png" alt="Amma in Devi Bhava" id="darshan-photo" />
      </div>
    </div>
    <canvas id="particles"></canvas>
    <div id="lotus-container"></div>
  </div>
</Base>

<script>
  import { initParticles } from '../components/particles';
  import { initAltar } from '../components/altar';
  import { initLotusNav } from '../components/lotus-nav';
  import { initTabMantra } from '../components/tab-mantra';
  import { initPhotoMode } from '../components/photo-mode';
  import { initJapaMode, destroyJapa } from '../components/japa-mode';
  import { initGarlandMode } from '../components/garland-mode';
  import { initTeachingsMode } from '../components/teachings-mode';
  import { initSoundMode } from '../components/sound-mode';
  import type { Mode } from '../components/lotus-nav';

  let modesInitialized = false;

  function initModes() {
    if (modesInitialized) return;
    modesInitialized = true;
    const room = document.getElementById('room')!;
    const darshan = document.getElementById('darshan')!;
    initPhotoMode(darshan, room);
    initJapaMode(room);
    initGarlandMode(room);
    initTeachingsMode(room);
    initSoundMode(room);
  }

  function handleModeChange(mode: Mode | null) {
    document.querySelectorAll('.mode-overlay').forEach(el => {
      (el as HTMLElement).classList.remove('active');
    });
    if (!mode) {
      destroyJapa();
      return;
    }
    const overlay = document.getElementById(`mode-${mode}`);
    if (overlay) overlay.classList.add('active');
    if (mode !== 'japa') destroyJapa();
  }

  function initAtmosphere() {
    const root = document.documentElement;
    const hour = new Date().getHours();

    let hue: number, saturation: number, lightness: number, warmth: number;

    if (hour >= 5 && hour < 8) {
      // Dawn — soft gold, gentle
      hue = 35; saturation = 60; lightness = 12; warmth = 0.7;
    } else if (hour >= 8 && hour < 12) {
      // Morning — warmer, brighter
      hue = 30; saturation = 55; lightness = 14; warmth = 0.8;
    } else if (hour >= 12 && hour < 16) {
      // Midday — brightest, most saturated
      hue = 25; saturation = 50; lightness = 16; warmth = 0.9;
    } else if (hour >= 16 && hour < 19) {
      // Evening — deep warmth, saffron
      hue = 20; saturation = 65; lightness = 13; warmth = 0.85;
    } else if (hour >= 19 && hour < 22) {
      // Dusk — crimson deepening
      hue = 350; saturation = 50; lightness = 10; warmth = 0.6;
    } else {
      // Night — intimate, lamp-like
      hue = 340; saturation = 40; lightness = 8; warmth = 0.4;
    }

    root.style.setProperty('--atm-hue', String(hue));
    root.style.setProperty('--atm-sat', `${saturation}%`);
    root.style.setProperty('--atm-lit', `${lightness}%`);
    root.style.setProperty('--atm-warmth', String(warmth));
    root.style.setProperty('--atm-glow-color', `hsl(${hue}, ${saturation}%, ${lightness + 10}%)`);
    root.style.setProperty('--atm-glow-opacity', String(warmth * 0.3));
  }

  function runThreshold() {
    const threshold = document.getElementById('threshold')!;
    const room = document.getElementById('room')!;
    const mantras = threshold.querySelectorAll<HTMLElement>('.mantra');

    let entered = false;

    function enterRoom() {
      if (entered) return;
      entered = true;

      threshold.classList.add('dissolving');
      threshold.addEventListener('transitionend', () => {
        threshold.style.display = 'none';
      }, { once: true });

      room.classList.add('entering');

      const canvas = document.getElementById('particles') as HTMLCanvasElement;
      if (canvas) altar.attachParticles(initParticles(canvas));

      const lotusContainer = document.getElementById('lotus-container')!;
      initLotusNav(lotusContainer, handleModeChange);

      initModes();
    }

    mantras.forEach((el, i) => {
      setTimeout(() => {
        el.classList.add('visible');
      }, 800 + i * 1200);
    });

    const autoEnterDelay = 800 + mantras.length * 1200 + 2500;
    const autoTimer = setTimeout(enterRoom, autoEnterDelay);

    threshold.addEventListener('click', () => {
      clearTimeout(autoTimer);
      enterRoom();
    });

    threshold.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        clearTimeout(autoTimer);
        enterRoom();
      }
    });

    threshold.setAttribute('tabindex', '0');
    threshold.focus();
  }

  initAtmosphere();
  initTabMantra();

  // Built before the threshold clears, so the altar's images are decoded by
  // the time the room fades in and nothing pops into place.
  const altar = initAltar(
    document.getElementById('altar')!,
    document.getElementById('darshan')!,
  );

  runThreshold();
</script>

<style>
  #threshold {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    background: #0a0008;
    cursor: pointer;
    opacity: 1;
    transition: opacity 2s ease-out;
  }

  #threshold.dissolving {
    opacity: 0;
    pointer-events: none;
  }

  .mantra-lines {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.8rem;
  }

  .mantra {
    font-size: clamp(1.2rem, 3vw, 2rem);
    opacity: 0;
    letter-spacing: 0.05em;
    color: #d4a574;
    transition: opacity 1.5s ease-in;
    text-shadow: 0 0 30px hsla(30, 60%, 50%, 0.3);
  }

  .mantra.visible {
    opacity: 1;
  }

  #room {
    position: fixed;
    inset: 0;
    opacity: 0;
    transition: opacity 2.5s ease-in 0.5s;
  }

  #room.entering {
    opacity: 1;
  }

  #atmosphere {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 60% 70% at 50% 50%,
        hsla(var(--atm-hue, 30), var(--atm-sat, 50%), calc(var(--atm-lit, 12%) + 8%), var(--atm-glow-opacity, 0.2)),
        transparent
      ),
      radial-gradient(
        ellipse 80% 90% at 50% 60%,
        hsla(var(--atm-hue, 30), var(--atm-sat, 50%), var(--atm-lit, 12%), 0.15),
        transparent
      );
    pointer-events: none;
    z-index: 1;
  }

  #altar {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;

    /* Height of the ledge surface above the bottom of the viewport. */
    --ledge-y: 23vh;
    --ledge-w: 66%;
    --ledge-inset: calc((100% - var(--ledge-w)) / 2);

    --frame-h: 54vh;
    --frame-w: min(calc(var(--frame-h) * 0.8), 78vw);

    --lamp-h: 62vh;
    /* Distance of each lamp's centre line from its side of the viewport. */
    --lamp-x: 12%;
  }

  /* Portrait and narrow windows: there is no room to flank the photo, so the
     lamps shrink back toward the edges and the ledge widens under them. */
  @media (max-aspect-ratio: 1/1) {
    #altar {
      --ledge-y: 19vh;
      --ledge-w: 86%;
      --frame-h: 46vh;
      --lamp-h: 40vh;
      --lamp-x: 9%;
    }
  }

  #darshan {
    position: absolute;
    inset: 0;
    /* Grid rather than flex so the outgoing and incoming photos of a
       crossfade occupy the same cell instead of sitting side by side. */
    display: grid;
    place-items: center;
    z-index: 0;
  }

  #particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
  }

  #lotus-container {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 50;
  }
</style>

<style is:global>
  .lotus-nav {
    position: relative;
    width: 140px;
    height: 140px;
    cursor: pointer;
  }

  .lotus-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 0 8px hsla(30, 60%, 50%, 0.3));
  }

  .lotus-center {
    fill: hsla(340, 40%, 55%, 0.9);
    stroke: hsla(35, 50%, 70%, 0.6);
    stroke-width: 1.5;
    cursor: pointer;
    transition: fill 0.4s ease, filter 0.4s ease;
  }

  .lotus-center:hover {
    fill: hsla(340, 50%, 62%, 1);
    filter: drop-shadow(0 0 6px hsla(340, 50%, 60%, 0.5));
  }

  .lotus-petal {
    fill: hsla(335, 45%, 65%, 0.85);
    stroke: hsla(35, 60%, 75%, 0.4);
    stroke-width: 0.5;
    cursor: pointer;
    transition: d 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
                fill 0.3s ease,
                filter 0.3s ease;
  }

  .lotus-petal:hover:not(.disabled) {
    fill: hsla(335, 55%, 72%, 1);
    filter: drop-shadow(0 0 4px hsla(335, 50%, 65%, 0.5));
  }

  .lotus-petal.active {
    fill: hsla(40, 60%, 70%, 0.95);
    stroke: hsla(40, 70%, 80%, 0.6);
  }

  .lotus-petal.disabled {
    fill: hsla(335, 20%, 45%, 0.4);
    stroke: hsla(35, 20%, 50%, 0.2);
    cursor: default;
  }

  .lotus-label {
    fill: #e8d5c4;
    font-size: 9px;
    font-family: system-ui, sans-serif;
    pointer-events: none;
    transition: opacity 0.4s ease 0.15s;
  }

  .lotus-label.disabled {
    fill: hsla(30, 20%, 60%, 0.5);
    font-style: italic;
  }

  .lotus-glow {
    position: absolute;
    bottom: 50%;
    right: 50%;
    transform: translate(50%, 50%);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: transparent;
    transition: background 0.6s ease, box-shadow 0.6s ease;
    pointer-events: none;
  }

  .lotus-glow.active {
    background: hsla(var(--glow-hue, 35), 50%, 50%, 0.08);
    box-shadow: 0 0 20px 8px hsla(var(--glow-hue, 35), 50%, 50%, 0.15);
  }

  /* Mode overlays — hidden by default */
  .mode-overlay {
    display: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .mode-overlay.active {
    display: flex;
    opacity: 1;
  }

  /* ------------------------------------------------------------------
     Altar

     Layer order inside #altar, back to front: backdrop, floor, frame,
     ledge, lamps, toran, offerings, then the two light passes that tie
     them together. #altar carries a z-index, so those blend modes are
     contained to the altar and never reach through to the page.
     ------------------------------------------------------------------ */

  .altar-stage {
    position: absolute;
    inset: 0;
  }

  .altar-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(
        ellipse 62% 54% at 50% 40%,
        hsla(var(--atm-hue, 30), 55%, 24%, 0.45),
        transparent 72%
      ),
      repeating-linear-gradient(
        90deg,
        hsl(348 34% 8%) 0 2.6%,
        hsl(352 28% 13%) 3.8%,
        hsl(348 34% 8%) 5.6%
      ),
      linear-gradient(180deg, hsl(345 32% 4%), hsl(348 30% 10%) 46%, hsl(346 30% 6%));
  }

  .altar-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30vh;
    z-index: 1;
    background: linear-gradient(
      180deg,
      transparent,
      hsla(20, 32%, 7%, 0.85) 42%,
      hsl(18 28% 5%)
    );
  }

  /* --- frame, mat, aperture --- */

  .altar-frame {
    position: absolute;
    left: 50%;
    bottom: calc(var(--ledge-y) - 1.2vh);
    transform: translateX(-50%);
    width: var(--frame-w);
    height: var(--frame-h);
    padding: 1.15vh;
    z-index: 3;
    border-radius: 0.3vh;
    /* A metal gradient needs a bright band and a dark band on the same
       plane; a two-stop ramp reads as plastic. */
    background: linear-gradient(
      152deg,
      #63461a 0%,
      #bd9542 13%,
      #efdaa2 25%,
      #a67d2d 39%,
      #74561f 53%,
      #d3af5c 71%,
      #866323 87%,
      #563e16 100%
    );
    box-shadow:
      0 0 0 0.22vh hsla(34, 50%, 14%, 0.9),
      0 1.8vh 4.5vh hsla(0, 0%, 0%, 0.7),
      inset 0 0 1.4vh hsla(30, 40%, 10%, 0.5);
  }

  .altar-mat {
    width: 100%;
    height: 100%;
    padding: 2.1vh;
    /* Deep red rather than a conventional cream mount: a bright mat would
       be the lightest thing on screen and would out-shout the photo. */
    background: linear-gradient(180deg, hsl(348 42% 15%), hsl(346 40% 10%));
    box-shadow:
      inset 0 0 0 0.16vh hsla(42, 55%, 52%, 0.45),
      inset 0 0 2.4vh hsla(0, 0%, 0%, 0.6);
  }

  .altar-aperture {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: hsl(345 30% 5%);
    box-shadow: inset 0 0.35vh 1.4vh hsla(0, 0%, 0%, 0.8);
  }

  /* Global, not scoped: photo-mode creates fresh <img> elements for each
     crossfade and those carry no scope attribute. */
  #darshan > img {
    grid-area: 1 / 1;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: brightness(0.9) saturate(1.08);
    transition: opacity 1.5s ease;
  }

  /* --- toran --- */

  .altar-toran {
    position: absolute;
    left: 50%;
    bottom: calc(var(--ledge-y) + var(--frame-h) - 2.6vh);
    transform: translateX(-50%);
    width: calc(var(--frame-w) + 14vh);
    height: 11vh;
    z-index: 6;
    filter: drop-shadow(0 0.5vh 0.7vh hsla(0, 0%, 0%, 0.6));
  }

  .altar-toran svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* --- ledge --- */

  .altar-ledge {
    position: absolute;
    left: var(--ledge-inset);
    bottom: 0;
    width: var(--ledge-w);
    height: var(--ledge-y);
    z-index: 4;
  }

  .altar-ledge-top {
    position: absolute;
    top: 0;
    left: -1.6%;
    right: -1.6%;
    height: 2.6vh;
    border-radius: 0.4vh 0.4vh 0 0;
    background: linear-gradient(180deg, hsl(38 48% 32%), hsl(32 42% 21%) 60%, hsl(26 38% 13%));
    box-shadow:
      0 -0.4vh 1.8vh hsla(30, 60%, 40%, 0.22),
      0 0.5vh 1.2vh hsla(0, 0%, 0%, 0.6);
  }

  .altar-ledge-cloth {
    position: absolute;
    inset: 2.4vh 0 0 0;
    background:
      repeating-linear-gradient(
        90deg,
        hsla(0, 0%, 0%, 0.24) 0 1.5%,
        transparent 1.5% 4%,
        hsla(45, 60%, 62%, 0.09) 4% 4.9%
      ),
      linear-gradient(180deg, hsl(40 60% 32%), hsl(34 54% 21%) 55%, hsl(26 44% 11%));
    box-shadow: inset 0 1.2vh 2.2vh hsla(0, 0%, 0%, 0.5);
  }

  /* --- lamps --- */

  .altar-lamp {
    position: absolute;
    bottom: 3vh;
    height: var(--lamp-h);
    /* The render is 440x1536; keeping the box at that ratio means the wick
       percentages below land on the actual lips. */
    aspect-ratio: 440 / 1536;
    z-index: 5;
  }

  .altar-lamp-left {
    left: var(--lamp-x);
    transform: translateX(-50%);
  }

  .altar-lamp-right {
    right: var(--lamp-x);
    transform: translateX(50%);
  }

  .altar-lamp-img {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 1.2vh 1.6vh hsla(0, 0%, 0%, 0.65));
  }

  /* Only the image is mirrored, never the flames — the wick positions are
     already symmetric, and a flame leaning the wrong way would give the
     trick away. */
  .altar-lamp-right .altar-lamp-img {
    transform: scaleX(-1);
  }

  .altar-wicks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* --- flames --- */

  .altar-flame {
    position: absolute;
    width: 1.5vh;
    height: 3.6vh;
    transform: translate(-50%, -94%) scale(var(--flame-scale, 1));
    transform-origin: 50% 100%;
    pointer-events: none;
  }

  .altar-flame-glow,
  .altar-flame-core {
    position: absolute;
    left: 50%;
    bottom: 0;
  }

  .altar-flame-glow {
    width: 320%;
    height: 150%;
    bottom: -26%;
    background: radial-gradient(
      ellipse at 50% 70%,
      hsla(34, 100%, 64%, 0.5),
      hsla(24, 100%, 48%, 0.2) 44%,
      transparent 72%
    );
    filter: blur(0.45vh);
    animation: flame-breathe var(--flicker-a, 1.9s) ease-in-out infinite alternate;
    animation-delay: var(--flicker-delay, 0s);
  }

  .altar-flame-core {
    width: 100%;
    height: 100%;
    border-radius: 50% 50% 46% 46% / 84% 84% 22% 22%;
    background: linear-gradient(
      180deg,
      hsl(48 100% 93%) 0%,
      hsl(43 100% 76%) 24%,
      hsl(30 100% 58%) 56%,
      hsla(16, 96%, 44%, 0.7) 86%,
      transparent 100%
    );
    filter: blur(0.1vh);
    animation: flame-dance var(--flicker-b, 2.4s) ease-in-out infinite alternate;
    animation-delay: var(--flicker-delay, 0s);
  }

  /* The two layers run on deliberately unrelated periods, so a wick never
     settles into a visible loop. */
  @keyframes flame-breathe {
    from {
      opacity: 0.6;
      transform: translateX(-50%) scale(0.9, 0.88);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) scale(1.1, 1.14);
    }
  }

  @keyframes flame-dance {
    from {
      transform: translateX(-50%) scale(0.9, 0.93) skewX(-4deg);
    }
    to {
      transform: translateX(-50%) scale(1.07, 1.1) skewX(5deg);
    }
  }

  /* --- offerings --- */

  .altar-offerings {
    position: absolute;
    left: var(--ledge-inset);
    width: var(--ledge-w);
    bottom: calc(var(--ledge-y) - 1.6vh);
    height: 12vh;
    z-index: 7;
    pointer-events: none;
  }

  .altar-strewn {
    position: absolute;
    left: -2%;
    right: -2%;
    bottom: -0.4vh;
    height: 3.4vh;
  }

  .altar-strewn svg {
    width: 100%;
    height: 100%;
  }

  .altar-pot,
  .altar-diya,
  .altar-incense {
    position: absolute;
    bottom: 0;
    transform: translateX(-50%);
  }

  .altar-pot img,
  .altar-diya img,
  .altar-incense img {
    display: block;
    height: 100%;
    width: auto;
    filter: drop-shadow(0 0.5vh 0.7vh hsla(0, 0%, 0%, 0.6));
  }

  .altar-pot {
    height: var(--pot-h, 6vh);
  }

  .altar-pot-left {
    left: 5%;
  }

  .altar-pot-right {
    left: 95%;
  }

  .altar-diya {
    height: 1.9vh;
  }

  .altar-diya-left {
    left: 41%;
  }

  .altar-diya-right {
    left: 59%;
  }

  .altar-diya-left img {
    transform: scaleX(-1);
  }

  /* The diya's wick spout sits at 89% of its render's width; mirrored for
     the left-hand one. Both derived from the same render geometry as WICKS. */
  .altar-diya .altar-flame {
    left: 89.3%;
    top: 43.7%;
    width: 0.85vh;
    height: 2vh;
  }

  .altar-diya-left .altar-flame {
    left: 10.7%;
  }

  .altar-incense {
    left: 50%;
    height: 2.6vh;
  }

  .altar-incense-stick {
    position: absolute;
    left: 50%;
    bottom: 52%;
    width: 0.16vh;
    height: 4.6vh;
    transform: translateX(-50%) rotate(2.5deg);
    transform-origin: 50% 100%;
    background: linear-gradient(180deg, hsl(22 32% 26%), hsl(28 34% 18%));
  }

  .altar-incense-tip {
    position: absolute;
    left: 54%;
    bottom: 228%;
    width: 0.32vh;
    height: 0.32vh;
    border-radius: 50%;
    background: hsla(20, 100%, 62%, 0.95);
    box-shadow: 0 0 0.6vh 0.16vh hsla(18, 100%, 55%, 0.45);
  }

  .altar-bloom {
    position: absolute;
    bottom: 0.2vh;
    width: var(--bloom-size, 2vh);
    height: var(--bloom-size, 2vh);
    transform: translateX(-50%);
    filter: drop-shadow(0 0.25vh 0.35vh hsla(0, 0%, 0%, 0.55));
  }

  .altar-bloom svg {
    width: 100%;
    height: 100%;
  }

  /* --- light unification ---
     Two passes over the finished composition. Without them the layers read
     as cut-outs on a background: the warm wash puts every object under the
     same lamp light, and the shade drops the corners away so the eye is
     pulled back to the face. */

  .altar-light {
    position: absolute;
    inset: 0;
    z-index: 8;
    pointer-events: none;
    mix-blend-mode: screen;
    background:
      radial-gradient(ellipse 22% 30% at var(--lamp-x) 46%, hsla(30, 92%, 56%, 0.17), transparent 70%),
      radial-gradient(
        ellipse 22% 30% at calc(100% - var(--lamp-x)) 46%,
        hsla(30, 92%, 56%, 0.17),
        transparent 70%
      ),
      radial-gradient(ellipse 34% 14% at 50% 84%, hsla(28, 94%, 55%, 0.14), transparent 74%);
  }

  .altar-shade {
    position: absolute;
    inset: 0;
    z-index: 8;
    pointer-events: none;
    mix-blend-mode: multiply;
    background: radial-gradient(
      ellipse 74% 74% at 50% 44%,
      transparent 32%,
      hsla(0, 0%, 0%, 0.6) 88%
    );
  }

  /* Photo mode */
  .photo-nav {
    /* Fixed, not absolute: the photo now lives inside the frame aperture,
       and the arrows belong at the edges of the viewport. */
    position: fixed;
    inset: 0;
    z-index: 20;
    align-items: center;
