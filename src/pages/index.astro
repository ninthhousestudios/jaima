---
import Base from '../layouts/Base.astro';
---
<Base>
  <div id="threshold">
    <div class="mantra-lines">
      <p class="mantra ml" lang="ml">ഓം അമൃതേശ്വര്യൈ നമഃ</p>
      <p class="mantra iast">oṃ amṛteśvaryai namaḥ</p>
      <p class="mantra dev" lang="hi">ॐ अमृतेश्वर्यै नमः</p>
    </div>
  </div>
  <div id="room">
    <div id="atmosphere"></div>
    <div id="altar">
      <div id="darshan">
        <img src="/images/photos/amma-devi1.png" alt="Amma in Devi Bhava" id="darshan-photo" />
      </div>
    </div>
    <canvas id="particles"></canvas>
    <div id="lotus-container"></div>
  </div>
</Base>

<script>
  import { initParticles } from '../components/particles';
  import { initAltar } from '../components/altar';
  import { initLotusNav } from '../components/lotus-nav';
  import { initTabMantra } from '../components/tab-mantra';
  import { initPhotoMode } from '../components/photo-mode';
  import { initJapaMode, activateJapa, destroyJapa } from '../components/japa-mode';
  import { initGarlandMode } from '../components/garland-mode';
  import { initTeachingsMode } from '../components/teachings-mode';
  import { initSoundMode } from '../components/sound-mode';
  import type { Mode } from '../components/lotus-nav';

  let modesInitialized = false;

  function initModes() {
    if (modesInitialized) return;
    modesInitialized = true;
    const room = document.getElementById('room')!;
    const darshan = document.getElementById('darshan')!;
    initPhotoMode(darshan, room);
    initJapaMode(room);
    initGarlandMode(room);
    initTeachingsMode(room);
    initSoundMode(room);
  }

  function handleModeChange(mode: Mode | null) {
    document.querySelectorAll('.mode-overlay').forEach(el => {
      (el as HTMLElement).classList.remove('active');
    });
    if (mode !== 'japa') destroyJapa();
    if (!mode) return;
    const overlay = document.getElementById(`mode-${mode}`);
    if (overlay) overlay.classList.add('active');
    // After .active, never before: the japa crawl measures its own line
    // height, and everything in a display:none overlay measures 0.
    if (mode === 'japa') activateJapa();
  }

  function initAtmosphere() {
    const root = document.documentElement;
    const hour = new Date().getHours();

    let hue: number, saturation: number, lightness: number, warmth: number;

    if (hour >= 5 && hour < 8) {
      // Dawn — soft gold, gentle
      hue = 35; saturation = 60; lightness = 12; warmth = 0.7;
    } else if (hour >= 8 && hour < 12) {
      // Morning — warmer, brighter
      hue = 30; saturation = 55; lightness = 14; warmth = 0.8;
    } else if (hour >= 12 && hour < 16) {
      // Midday — brightest, most saturated
      hue = 25; saturation = 50; lightness = 16; warmth = 0.9;
    } else if (hour >= 16 && hour < 19) {
      // Evening — deep warmth, saffron
      hue = 20; saturation = 65; lightness = 13; warmth = 0.85;
    } else if (hour >= 19 && hour < 22) {
      // Dusk — crimson deepening
      hue = 350; saturation = 50; lightness = 10; warmth = 0.6;
    } else {
      // Night — intimate, lamp-like
      hue = 340; saturation = 40; lightness = 8; warmth = 0.4;
    }

    root.style.setProperty('--atm-hue', String(hue));
    root.style.setProperty('--atm-sat', `${saturation}%`);
    root.style.setProperty('--atm-lit', `${lightness}%`);
    root.style.setProperty('--atm-warmth', String(warmth));
    root.style.setProperty('--atm-glow-color', `hsl(${hue}, ${saturation}%, ${lightness + 10}%)`);
    root.style.setProperty('--atm-glow-opacity', String(warmth * 0.3));
  }

  function runThreshold() {
    const threshold = document.getElementById('threshold')!;
    const room = document.getElementById('room')!;
    const mantras = threshold.querySelectorAll<HTMLElement>('.mantra');

    let entered = false;

    function enterRoom() {
      if (entered) return;
      entered = true;

      threshold.classList.add('dissolving');
      threshold.addEventListener('transitionend', () => {
        threshold.style.display = 'none';
      }, { once: true });

      room.classList.add('entering');

      const canvas = document.getElementById('particles') as HTMLCanvasElement;
      if (canvas) altar.attachParticles(initParticles(canvas));

      const lotusContainer = document.getElementById('lotus-container')!;
      initLotusNav(lotusContainer, handleModeChange);

      initModes();
    }

    mantras.forEach((el, i) => {
      setTimeout(() => {
        el.classList.add('visible');
      }, 800 + i * 1200);
    });

    const autoEnterDelay = 800 + mantras.length * 1200 + 2500;
    const autoTimer = setTimeout(enterRoom, autoEnterDelay);

    threshold.addEventListener('click', () => {
      clearTimeout(autoTimer);
      enterRoom();
    });

    threshold.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        clearTimeout(autoTimer);
        enterRoom();
      }
    });

    threshold.setAttribute('tabindex', '0');
    threshold.focus();
  }

  initAtmosphere();
  initTabMantra();

  // Built before the threshold clears, so the altar's images are decoded by
  // the time the room fades in and nothing pops into place.
  const altar = initAltar(
    document.getElementById('altar')!,
    document.getElementById('darshan')!,
  );

  runThreshold();
</script>

<style>
  #threshold {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    background: #0a0008;
    cursor: pointer;
    opacity: 1;
    transition: opacity 2s ease-out;
  }

  #threshold.dissolving {
    opacity: 0;
    pointer-events: none;
  }

  .mantra-lines {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.8rem;
  }

  .mantra {
    font-size: clamp(1.2rem, 3vw, 2rem);
    opacity: 0;
    letter-spacing: 0.05em;
    color: #d4a574;
    transition: opacity 1.5s ease-in;
    text-shadow: 0 0 30px hsla(30, 60%, 50%, 0.3);
  }

  .mantra.visible {
    opacity: 1;
  }

  #room {
    position: fixed;
    inset: 0;
    opacity: 0;
    transition: opacity 2.5s ease-in 0.5s;
  }

  #room.entering {
    opacity: 1;
  }

  #atmosphere {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 60% 70% at 50% 50%,
        hsla(var(--atm-hue, 30), var(--atm-sat, 50%), calc(var(--atm-lit, 12%) + 8%), var(--atm-glow-opacity, 0.2)),
        transparent
      ),
      radial-gradient(
        ellipse 80% 90% at 50% 60%,
        hsla(var(--atm-hue, 30), var(--atm-sat, 50%), var(--atm-lit, 12%), 0.15),
        transparent
      );
    pointer-events: none;
    z-index: 1;
  }

  #altar {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;

    /* Height of the ledge surface above the bottom of the viewport. A low
       platform: it carries the offerings, it does not carry the photo. */
    --ledge-y: 6vh;
    --ledge-w: 66vw;
    --ledge-inset: calc((100vw - var(--ledge-w)) / 2);

    /* Where the two flanking incense sticks stand, as a fraction of the ledge
       in from each end — midway between the centre incense and the pots. They
       stand in front of the photo's lower corners and below its bottom edge,
       which is where offerings belong. */
    --incense-x: 27.5%;

    /* Vertical space is what limits the photo, so height leads and width
       follows the frame's 4:5. The vw term only bites on a window too narrow
       to hold that width at all. */
    --frame-h: min(72vh, calc(92vw * 1.25));
    --frame-w: calc(var(--frame-h) * 0.8);
    /* The photo hangs on the wall — its height is its own, not the ledge's.
       Equal air above and below: 14 + 72 + 14 = 100. */
    --frame-y: 14vh;

    /* The garland is strung high on the wall, near the ceiling. It is not
       tied to the top of the frame; it hangs above it with a gap. */
    --toran-y: 3vh;

    /* Bracket shelves carrying the arati lamps, in the strip of bare wall
       between each nilavilakku and the frame. That strip is the narrowest
       thing in the layout — at 4:3 it is only about 10vw — so widening the
       lamps or the photo squeezes these first. */
    --shelf-x: 23.5%;
    --shelf-y: 44vh;
    --arati-h: 8vh;

    --lamp-h: 62vh;
    /* Distance of each lamp's centre line from its side of the viewport. */
    --lamp-x: 12%;
  }

  /* Portrait and narrow windows: there is no room to flank the photo, so the
     lamps shrink back toward the edges and the ledge widens under them.
     Best-effort only — the composition is built for landscape and is not
     expected to hold up on a phone. */
  @media (max-aspect-ratio: 1/1) {
    #altar {
      --ledge-y: 5vh;
      --ledge-w: 86vw;
      --frame-y: 11vh;
      --lamp-h: 40vh;
      --lamp-x: 9%;
    }
  }

  #darshan {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
  }

  #lotus-container {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 50;
  }
</style>

<style is:global>
  .lotus-nav {
    position: relative;
    width: 140px;
    height: 140px;
    cursor: pointer;
  }

  .lotus-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 0 8px hsla(30, 60%, 50%, 0.3));
  }

  /* A cut-out photograph, not a shape — fill and stroke do nothing here, so
     every state it has is a filter. */
  .lotus-center {
    cursor: pointer;
    filter: drop-shadow(0 0 7px hsla(335, 55%, 45%, 0.45));
    transition: filter 0.4s ease;
  }

  /* Transparent, forgiving toggle target. Sits above the closed petals so a
     click near the middle always reaches the toggle instead of being eaten by
     a petal stub. Open petals start at r=52, well clear of it. */
  .lotus-hit {
    fill: transparent;
    cursor: pointer;
  }

  .lotus-svg:has(.lotus-hit:hover) .lotus-center {
    filter: drop-shadow(0 0 12px hsla(335, 65%, 55%, 0.65)) brightness(1.1);
  }

  /* Closed petals are collapsed onto the centre, where they would sit as
     stubs on top of the flower. Hide them, and keep them from taking clicks
     meant for the toggle underneath. */
  .lotus-nav:not(.open) .lotus-petal {
    pointer-events: none;
    opacity: 0;
  }

  .lotus-petal {
    cursor: pointer;
    transition: opacity 0.4s ease;
  }

  .lotus-petal.disabled { cursor: default; }

  /* The petal you see. The petal you can hit is .lotus-petal-hit — an open
     blade is a ~16x6px lens, far too small to click reliably. */
  .lotus-blade {
    fill: hsla(335, 45%, 65%, 0.85);
    stroke: hsla(35, 60%, 75%, 0.4);
    stroke-width: 0.5;
    transition: d 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
                fill 0.3s ease,
                filter 0.3s ease;
  }

  .lotus-petal-hit {
    fill: transparent;
  }

  .lotus-petal:hover:not(.disabled) .lotus-blade {
    fill: hsla(335, 55%, 72%, 1);
    filter: drop-shadow(0 0 4px hsla(335, 50%, 65%, 0.5));
  }

  .lotus-petal.active .lotus-blade {
    fill: hsla(40, 60%, 70%, 0.95);
    stroke: hsla(40, 70%, 80%, 0.6);
  }

  .lotus-petal.disabled .lotus-blade {
    fill: hsla(335, 20%, 45%, 0.4);
    stroke: hsla(35, 20%, 50%, 0.2);
  }

  .lotus-label {
    fill: #e8d5c4;
    font-size: 9px;
    font-family: system-ui, sans-serif;
    pointer-events: none;
    transition: opacity 0.4s ease 0.15s;
  }

  .lotus-label.disabled {
    fill: hsla(30, 20%, 60%, 0.5);
    font-style: italic;
  }

  .lotus-glow {
    position: absolute;
    bottom: 50%;
    right: 50%;
    transform: translate(50%, 50%);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: transparent;
    transition: background 0.6s ease, box-shadow 0.6s ease;
    pointer-events: none;
  }

  .lotus-glow.active {
    background: hsla(var(--glow-hue, 35), 50%, 50%, 0.08);
    box-shadow: 0 0 20px 8px hsla(var(--glow-hue, 35), 50%, 50%, 0.15);
  }

  /* Mode overlays — hidden by default */
  .mode-overlay {
    display: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .mode-overlay.active {
    display: flex;
    opacity: 1;
  }

  /* ------------------------------------------------------------------
     Altar

     Layer order inside #altar, back to front: backdrop, floor, frame,
     ledge, lamps, toran, offerings, then the two light passes that tie
     them together. #altar carries a z-index, so those blend modes are
     contained to the altar and never reach through to the page.
     ------------------------------------------------------------------ */

  .altar-stage {
    position: absolute;
    inset: 0;
  }

  .altar-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(
        ellipse 62% 54% at 50% 40%,
        hsla(var(--atm-hue, 30), 55%, 24%, 0.45),
        transparent 72%
      ),
      repeating-linear-gradient(
        90deg,
        hsl(348 34% 8%) 0 2.6%,
        hsl(352 28% 13%) 3.8%,
        hsl(348 34% 8%) 5.6%
      ),
      linear-gradient(180deg, hsl(345 32% 4%), hsl(348 30% 10%) 46%, hsl(346 30% 6%));
  }

  .altar-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30vh;
    z-index: 1;
    background: linear-gradient(
      180deg,
      transparent,
      hsla(20, 32%, 7%, 0.85) 42%,
      hsl(18 28% 5%)
    );
  }

  /* --- frame, mat, aperture --- */

  .altar-frame {
    position: absolute;
    left: 50%;
    bottom: var(--frame-y);
    transform: translateX(-50%);
    width: var(--frame-w);
    height: var(--frame-h);
    padding: 1.15vh;
    z-index: 3;
    border-radius: 0.3vh;
    /* A metal gradient needs a bright band and a dark band on the same
       plane; a two-stop ramp reads as plastic. */
    background: linear-gradient(
      152deg,
      #63461a 0%,
      #bd9542 13%,
      #efdaa2 25%,
      #a67d2d 39%,
      #74561f 53%,
      #d3af5c 71%,
      #866323 87%,
      #563e16 100%
    );
    box-shadow:
      0 0 0 0.22vh hsla(34, 50%, 14%, 0.9),
      0 1.8vh 4.5vh hsla(0, 0%, 0%, 0.7),
      inset 0 0 1.4vh hsla(30, 40%, 10%, 0.5);
  }

  .altar-mat {
    width: 100%;
    height: 100%;
    padding: 2.1vh;
    /* Deep red rather than a conventional cream mount: a bright mat would
       be the lightest thing on screen and would out-shout the photo. */
    background: linear-gradient(180deg, hsl(348 42% 15%), hsl(346 40% 10%));
    box-shadow:
      inset 0 0 0 0.16vh hsla(42, 55%, 52%, 0.45),
      inset 0 0 2.4vh hsla(0, 0%, 0%, 0.6);
  }

  .altar-aperture {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: hsl(345 30% 5%);
    box-shadow: inset 0 0.35vh 1.4vh hsla(0, 0%, 0%, 0.8);
  }

  /* Global, not scoped: photo-mode creates fresh <img> elements for each
     crossfade and those carry no scope attribute. */
  /* Absolutely positioned, so the crossfading photos stack without any of
     them being able to size the box the others live in. This was a grid, and
     a grid cannot do that: `1fr` means `minmax(auto, 1fr)`, and that auto
     floor stops the track shrinking below its content, so the row grew to
     whichever photo was tallest and overflowed the aperture. The box top
     stayed put while its height changed, which pushed the contained picture
     down while two photos were present and let it rise when one was removed.
     Out here the box is the aperture for every photo, loaded or not. */
  #darshan > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0.9) saturate(1.08);
    /* Kept in step with FADE_MS in photo-mode.ts. */
    transition: opacity 1.5s ease;
  }

  /* --- toran --- */

  .altar-toran {
    position: absolute;
    left: 50%;
    top: var(--toran-y);
    transform: translateX(-50%);
    width: calc(var(--frame-w) + 14vh);
    z-index: 6;
    filter: drop-shadow(0 0.5vh 0.7vh hsla(0, 0%, 0%, 0.6));
  }

  /* Height left to the viewBox's own 1000:90. A fixed height letterboxes the
     garland inside its box and buries --toran-y under dead space, which is
     why the toran used to sit far lower than its number suggested. */
  .altar-toran svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* --- ledge --- */

  .altar-ledge {
    position: absolute;
    left: var(--ledge-inset);
    bottom: 0;
    width: var(--ledge-w);
    height: var(--ledge-y);
    z-index: 4;
  }

  .altar-ledge-top {
    position: absolute;
    top: 0;
    left: -1.6%;
    right: -1.6%;
    height: 1.8vh;
    border-radius: 0.4vh 0.4vh 0 0;
    background: linear-gradient(180deg, hsl(38 48% 32%), hsl(32 42% 21%) 60%, hsl(26 38% 13%));
    box-shadow:
      0 -0.4vh 1.8vh hsla(30, 60%, 40%, 0.22),
      0 0.5vh 1.2vh hsla(0, 0%, 0%, 0.6);
  }

  .altar-ledge-cloth {
    position: absolute;
    inset: 1.6vh 0 0 0;
    background:
      repeating-linear-gradient(
        90deg,
        hsla(0, 0%, 0%, 0.24) 0 1.5%,
        transparent 1.5% 4%,
        hsla(45, 60%, 62%, 0.09) 4% 4.9%
      ),
      linear-gradient(180deg, hsl(40 60% 32%), hsl(34 54% 21%) 55%, hsl(26 44% 11%));
    box-shadow: inset 0 1.2vh 2.2vh hsla(0, 0%, 0%, 0.5);
  }

  /* --- lamps --- */

  .altar-lamp {
    position: absolute;
    bottom: 3vh;
    height: var(--lamp-h);
    /* The render is 440x1536; keeping the box at that ratio means the wick
       percentages below land on the actual lips. */
    aspect-ratio: 440 / 1536;
    z-index: 5;
  }

  .altar-lamp-left {
    left: var(--lamp-x);
    transform: translateX(-50%);
  }

  .altar-lamp-right {
    right: var(--lamp-x);
    transform: translateX(50%);
  }

  .altar-lamp-img {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 1.2vh 1.6vh hsla(0, 0%, 0%, 0.65));
  }

  /* Only the image is mirrored, never the flames — the wick positions are
     already symmetric, and a flame leaning the wrong way would give the
     trick away. */
  .altar-lamp-right .altar-lamp-img {
    transform: scaleX(-1);
  }

  .altar-wicks,
  .arati-wicks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* --- shelves: a bracket on the wall, with an arati lamp standing on it --- */

  .altar-shelf {
    position: absolute;
    bottom: var(--shelf-y);
    width: calc(var(--arati-h) * 1.55);
    height: 0;
    transform: translateX(-50%);
    z-index: 5;
  }

  .altar-shelf-left {
    left: var(--shelf-x);
  }

  .altar-shelf-right {
    left: calc(100% - var(--shelf-x));
  }

  /* Same timber as the ledge, so the room reads as one carpenter's work. */
  .altar-shelf-slab {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0.9vh;
    border-radius: 0.25vh 0.25vh 0 0;
    background: linear-gradient(180deg, hsl(38 48% 30%), hsl(32 42% 19%) 62%, hsl(26 38% 11%));
    box-shadow:
      0 -0.3vh 1.4vh hsla(30, 60%, 40%, 0.18),
      0 0.4vh 1vh hsla(0, 0%, 0%, 0.6);
  }

  /* The bracket under it. A trapezoid via border widths — cheaper than an SVG
     for a shape this small and it inherits no colour of its own. */
  .altar-shelf-corbel {
    position: absolute;
    top: 0.9vh;
    left: 50%;
    width: 34%;
    height: 1.6vh;
    transform: translateX(-50%);
    background: linear-gradient(180deg, hsl(30 40% 17%), hsl(24 34% 9%));
    clip-path: polygon(0 0, 100% 0, 68% 100%, 32% 100%);
  }

  .arati-lamp {
    position: absolute;
    left: 50%;
    /* Stands ON the slab. The render carries 9.54% of clear margin below the
       dish (ORTHO_MARGIN), so the box has to sink by that much or the lamp
       floats. altar-assets.py prints this as the content box on every render. */
    bottom: calc(var(--arati-h) * -0.0954);
    height: var(--arati-h);
    /* The render is 1536x1310; the wick fractions in arati-lamp.ts land on the
       actual cups only at that ratio. */
    aspect-ratio: 1536 / 1310;
    /* Turns about the grip — the centre of the dish's underside, where a hand
       holds it. GRIP in arati-lamp.ts is the same number. */
    transform-origin: 50% 88.24%;
    transform: translateX(-50%) rotate(var(--wave-tilt, 0deg));
    --flame-plumb: calc(-1 * var(--wave-tilt, 0deg));
  }

  .arati-lamp-img {
    width: 100%;
    height: 100%;
    display: block;
    filter: drop-shadow(0 0.6vh 0.9vh hsla(0, 0%, 0%, 0.6));
  }

  /* --- flames --- */

  .altar-flame {
    position: absolute;
    width: 1.5vh;
    height: 3.6vh;
    /* --flame-plumb is how a waved lamp keeps its flames upright: the lamp
       rotates, each flame rotates back by the same angle about its own wick.
       Zero everywhere that does not move. */
    transform: translate(-50%, -94%) rotate(var(--flame-plumb, 0deg))
      scale(var(--flame-scale, 1));
    transform-origin: 50% 100%;
    pointer-events: none;
  }

  /* Small lamp, small flames. */
  .arati-lamp .altar-flame {
    width: 0.8vh;
    height: 1.9vh;
  }

  .altar-flame-glow,
  .altar-flame-core {
    position: absolute;
    left: 50%;
    bottom: 0;
  }

  .altar-flame-glow {
    width: 320%;
    height: 150%;
    bottom: -26%;
    background: radial-gradient(
      ellipse at 50% 70%,
      hsla(34, 100%, 64%, 0.5),
      hsla(24, 100%, 48%, 0.2) 44%,
      transparent 72%
    );
    filter: blur(0.45vh);
    animation: flame-breathe var(--flicker-a, 1.9s) ease-in-out infinite alternate;
